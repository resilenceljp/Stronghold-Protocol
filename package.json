{
  "name": "stronghold-protocol-alliance",
  "version": "0.2.5-20p-fun.8",
  "private": true,
  "description": "基于 sganggs 原版与 LongQianChen 20人分支的非商业扩展：娱乐控制台、无尽模拟、藏品和独立监视台",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/resilenceljp/Stronghold-Protocol-20p",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resilenceljp/Stronghold-Protocol-20p.git"
  },
  "bugs": {
    "url": "https://github.com/resilenceljp/Stronghold-Protocol-20p/issues"
  },
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "golden": "node tools/golden.mjs",
    "golden:update": "node tools/golden.mjs --update",
    "vendor": "node tools/vendor.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "postinstall": "node tools/vendor.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node scripts/launch.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --checkJs -p jsconfig.json",
    "check:imports": "node tools/check-imports.mjs",
    "ci": "node tools/ci.mjs",
    "package": "node tools/package.mjs",
    "package:lite": "node tools/package.mjs --lite",
    "assets:pack": "node tools/asset-cache-pack.mjs",
    "monitor": "node monitor/server.mjs",
    "sync:upstream": "node tools/sync-upstream-20p.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.23.0",
    "htm": "^3.1.1",
    "html-to-image": "1.11.13",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.2"
  }
}
